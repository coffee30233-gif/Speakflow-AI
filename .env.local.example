# Supabase（公開值，前端可見，安全性由 Postgres Row Level Security 把關）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key（僅能在 Server 端使用，會繞過 RLS，絕對不可加 NEXT_PUBLIC_ 前綴）
# 目前架構下較少會用到，僅在需要用管理員權限做批次處理／後台工具時才需要
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Keys（絕對不可加 NEXT_PUBLIC_ 前綴，僅能在 Server / API Route 使用）
GEMINI_API_KEY=
OPENAI_API_KEY=
